<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.routeinai.backend.attendance.mapper.AttendanceMapper">
    <resultMap id="AttendanceResultMap" type="com.routeinai.backend.attendance.entity.Attendance">
        <id property="attendanceId" column="attendance_id"/>
        <result property="userId" column="user_id"/>
        <result property="attendanceDate" column="attendance_date"/>
        <result property="popupShown" column="popup_shown"/>
        <result property="createDt" column="create_dt"/>
    </resultMap>

    <select id="findByUserIdAttendance" resultMap="AttendanceResultMap">
        SELECT
            attendance_id,
            user_id,
            attendance_date,
            popup_shown,
            create_dt
        FROM
            attendance_tb
        WHERE
            user_id = #{userId}
        AND
            attendance_date = #{attendanceDate}
    </select>

    <insert id="insertAttendance">
        INSERT INTO attendance_tb (user_id, attendance_date)
        VALUES (#{userId}, #{attendanceDate})
    </insert>

    <select id="findByUserIdAllAttendance" resultMap="AttendanceResultMap">
        SELECT
            attendance_id,
            user_id,
            attendance_date,
            popup_shown,
            create_dt
        FROM
            attendance_tb
        WHERE
            user_id = #{userId}
        ORDER BY
            attendance_date DESC
    </select>
</mapper>