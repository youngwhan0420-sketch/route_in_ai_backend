<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.routeinai.backend.board.mapper.RecommendMapper">
    <resultMap id="RecommendResultMap" type="com.routeinai.backend.board.entity.Recommend">
        <id property="recommendId" column="recommend_id"/>
        <result property="userId" column="user_id"/>
        <result property="boardId" column="board_id"/>
        <result property="createDt" column="create_dt"/>
    </resultMap>

    <delete id="deleteRecommend">
        DELETE FROM recommend_tb
        WHERE
            user_id = #{userId}
        AND
            board_id = #{boardId}
    </delete>

    <insert id="insertRecommend" useGeneratedKeys="true" keyProperty="recommendId">
        INSERT INTO recommend_tb (
            user_id, board_id
        )
        VALUES (
            #{userId}, #{boardId}
        )


    </insert>

    <select id="findByUserIdAndBoardId" resultMap="RecommendResultMap">
        SELECT
            recommend_id,
            user_id,
            board_id,
            create_dt
        FROM
            recommend_tb
        WHERE
            user_id = #{userId}
        AND
            board_id = #{boardId}
    </select>

    <select id="countByBoardId"
            resultType="java.lang.Integer">

        SELECT COUNT(*)
        FROM recommend_tb
        WHERE board_id = #{boardId}

    </select>
</mapper>