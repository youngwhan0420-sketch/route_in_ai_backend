<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.routeinai.backend.board.mapper.BoardMapper">
    <resultMap id="BoardResultMap" type="com.routeinai.backend.board.entity.Board">
        <id property="boardId" column="board_id"/>
        <result property="userId" column="user_id"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="tags" column="tags"/>
        <result property="createDt" column="create_dt"/>
        <result property="updateDt" column="update_dt"/>
    </resultMap>

    <select id="findByBoardId" resultMap="BoardResultMap">
        SELECT
            board_id,
            user_id,
            type,
            title,
            content,
            tags,
            create_dt,
            update_dt
        FROM
            board_tb
        WHERE
            board_id = #{boardId}
    </select>

    <select id="findAllBoardList" resultMap="BoardResultMap">
        SELECT
            board_id,
            user_id,
            type,
            title,
            content,
            tags,
            create_dt,
            update_dt
        FROM
            board_tb
        ORDER BY
            create_dt DESC
    </select>

    <select id="findBoardByUserId" resultMap="BoardResultMap">
        SELECT
            board_id,
            user_id,
            type,
            title,
            content,
            tags,
            create_dt,
            update_dt
        FROM
            board_tb
        WHERE
            user_id = #{userId}
    </select>

    <insert id="insertBoard" useGeneratedKeys="true" keyProperty="boardId">
        INSERT INTO board_tb (user_id, type, title, content, tags)
        VALUES (#{userId}, #{type}, #{title}, #{content}, #{tags})
    </insert>

    <delete id="deleteBoard">
        DELETE FROM board_tb
        WHERE
            board_id = #{boardId}
    </delete>

    <update id="updateBoard">
        UPDATE board_tb
        SET
            type = #{type},
            title = #{title},
            content = #{content},
            tags = #{tags},
            update_dt = CURRENT_TIMESTAMP
        WHERE
            board_id = #{boardId}
    </update>
</mapper>